# ─────────────────────────────────────────────────────────────────────────────
# Ahadi environment. Copy to .env and fill in. Never commit .env.
# See docs/SETUP.md for where every value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
NODE_ENV=development
# 32+ random chars. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Enables the one-click Client / Worker / Admin switcher for demos. Never true in production.
DEMO_MODE=true

# Database — Neon Postgres
# Pooled connection (host contains "-pooler"), used by the web app and worker at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/ahadi?sslmode=require&channel_binding=require
# Direct (unpooled) connection, used only for migrations. Falls back to DATABASE_URL if empty.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/ahadi?sslmode=require&channel_binding=require

# Queue — Redis (local: docker compose / redis-server; prod: Upstash rediss://… or a Render Key Value)
REDIS_URL=redis://localhost:6379
# Free hosting: run the BullMQ worker inside the web server (no separate worker service).
RUN_WORKER_IN_WEB=false
WORKER_CONCURRENCY=5

# PayPal (sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI provider: openrouter (default when OPENROUTER_API_KEY is set) or anthropic
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Free defaults; with credits use e.g. anthropic/claude-sonnet-4.5 or openai/gpt-4o
OPENROUTER_MODEL_ARCHITECT=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL_VERIFIER=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL_FAST=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
OPENROUTER_MAX_TOKENS=8000
# Anthropic API (alternative provider)
ANTHROPIC_API_KEY=
MODEL_ARCHITECT=claude-opus-5-5
MODEL_VERIFIER=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# Verification
# Code criteria (build/tests) run in a sandbox: e2b (needs SANDBOX_API_KEY) or docker (needs a Docker host).
SANDBOX_PROVIDER=e2b               # e2b | docker | none
SANDBOX_API_KEY=
# Private GitHub repos for code verification (read-only token).
GITHUB_TOKEN=
# Chromium for website evidence. Empty = Playwright's own browser cache (npx playwright-core install chromium-headless-shell).
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
VERIFY_TIMEOUT_MIN=15

# Statements: Ed25519 PKCS#8 PEM. Empty = derived from SESSION_SECRET (stable while that doesn't change).
AHADI_SIGNING_KEY=

# Email (magic-link sign-in). Empty = links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Ahadi <no-reply@ahadi.dev>"

# Speech-to-text for voice briefs (optional): whisper (OpenAI API key) or deepgram
STT_PROVIDER=whisper
STT_API_KEY=

# WhatsApp (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Policy
PLATFORM_FEE_BPS=150               # 1.5%
OBJECTION_WINDOW_HOURS=48          # set to 0.05 for demos
HUMAN_CONFIRM_ABOVE_USD=1000
MIN_AUTO_CONFIDENCE=0.80
MAX_ATTEMPTS=3
KES_PER_USD=129.50                 # M-Pesa estimate only

# Demo — sandbox personal accounts from the PayPal developer dashboard
DEMO_CLIENT_EMAIL=client@ahadi.test
DEMO_WORKER_EMAIL=worker@ahadi.test
DEMO_ADMIN_EMAIL=admin@ahadi.test
DEMO_BUYER_PAYPAL_EMAIL=
DEMO_WORKER_PAYPAL_EMAIL=
